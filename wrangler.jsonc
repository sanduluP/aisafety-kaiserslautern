{
  // Cloudflare Workers static-assets config.
  //
  // The site is deployed as a Worker serving static assets (the live URL is a
  // *.workers.dev one, not *.pages.dev). Workers Builds reads this file to work
  // out what to publish, so it needs to stay in the repo root.
  //
  // Static files are served directly. Only /api/* runs worker/index.js, which emails
  // the "Start a group" form. It needs, in the Cloudflare dashboard: Email Routing on
  // for the domain, and the secret FORM_TO set to a verified destination address
  // (kept out of this public repo). See CONTENT-TODO.md.
  //
  // If the project is ever moved to Cloudflare Pages instead, delete this file
  // and set the build output directory to "/" in the Pages settings.

  "name": "aisafety-kaiserslautern",
  "compatibility_date": "2026-08-04",
  "main": "worker/index.js",

  // no restriction: sends only to verified destination addresses of the account
  "send_email": [{ "name": "EMAIL" }],

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // serve 404.html with a real 404 status for unknown paths
    "not_found_handling": "404-page"
  }
}
